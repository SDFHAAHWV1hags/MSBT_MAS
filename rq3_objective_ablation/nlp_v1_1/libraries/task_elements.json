{
  "version":"1.1",
  "description":"Frozen lightweight Task Element Library. Atomic elements ensure every supported capability can be covered; composite elements improve fluency but are not required.",
  "elements":[
    {"id":"te_web_only","intent":"web_retrieval","capabilities":["web_retrieval"],"slots":{"operation":"locate","object":"public_information","source":"web","artifact":"web_resource","output":"short_fact"},"constraints":["requires_public_web_source"],"text":"Locate information from a publicly accessible Web source."},
    {"id":"te_document_only","intent":"document_inspection","capabilities":["document_inspection"],"slots":{"operation":"inspect","object":"document_internal_fact","source":"document","artifact":"document","output":"short_fact"},"constraints":["requires_document_internal_evidence","anti_search_snippet_shortcut"],"text":"Inspect the internal content of a document and extract the requested evidence."},
    {"id":"te_compute_only","intent":"computation","capabilities":["executable_computation"],"slots":{"operation":"compute","object":"derived_value","source":"provided_or_retrieved_data","artifact":"data","output":"numeric"},"constraints":["requires_actual_computation"],"text":"Perform a calculation or executable transformation to derive the requested result."},
    {"id":"te_verify_only","intent":"verification","capabilities":["verification"],"slots":{"operation":"verify","object":"candidate_fact","source":"independent_evidence","artifact":"evidence","output":"verified_fact"},"constraints":["requires_independent_verification"],"text":"Verify a candidate result using an independent source or consistency check."},
    {"id":"te_extract_only","intent":"data_extraction","capabilities":["data_extraction"],"slots":{"operation":"extract","object":"structured_information","source":"data_source","artifact":"source_data","output":"structured_data"},"constraints":["requires_data_extraction"],"text":"Extract specific information or structured data from the supplied or retrieved source."},
    {"id":"te_analyze_only","intent":"data_analysis","capabilities":["data_analysis"],"slots":{"operation":"analyze","object":"structured_data","source":"data_source","artifact":"table_or_dataset","output":"derived_result"},"constraints":["requires_data_analysis"],"text":"Analyze, compare, aggregate, or derive a result from structured data."},
    {"id":"te_code_only","intent":"code_generation","capabilities":["code_generation"],"slots":{"operation":"generate_code","object":"program_artifact","source":"task_specification","artifact":"code","output":"code_artifact"},"constraints":["requires_code_generation"],"text":"Produce code or a program artifact needed to solve the task."},

    {"id":"te_web_document","intent":"grounded_fact_retrieval","capabilities":["web_retrieval","document_inspection"],"slots":{"operation":"locate_and_extract","object":"document_fact","source":"web","artifact":"document","output":"short_fact"},"constraints":["requires_public_web_source","requires_document_internal_evidence","anti_search_snippet_shortcut"],"text":"Locate a public document online and extract a requested fact from inside it."},
    {"id":"te_web_verify","intent":"fact_verification","capabilities":["web_retrieval","verification"],"slots":{"operation":"retrieve_and_verify","object":"factual_claim","source":"multiple_web_sources","artifact":"web_resource","output":"verified_fact"},"constraints":["requires_public_web_source","requires_independent_verification"],"text":"Retrieve a fact online and confirm it using independent evidence."},
    {"id":"te_document_compute","intent":"document_based_computation","capabilities":["document_inspection","executable_computation"],"slots":{"operation":"extract_and_compute","object":"derived_value","source":"document","artifact":"document","output":"numeric"},"constraints":["requires_document_internal_evidence","requires_actual_computation"],"text":"Extract values from a document and compute a derived result."},
    {"id":"te_web_document_compute","intent":"grounded_document_computation","capabilities":["web_retrieval","document_inspection","executable_computation"],"slots":{"operation":"locate_extract_compute","object":"derived_value","source":"web","artifact":"document","output":"numeric"},"constraints":["requires_public_web_source","requires_document_internal_evidence","requires_actual_computation"],"text":"Locate a document online, inspect it for needed values, and compute the requested result."},
    {"id":"te_extract_analyze","intent":"data_analysis","capabilities":["data_extraction","data_analysis"],"slots":{"operation":"extract_and_analyze","object":"structured_data","source":"data_source","artifact":"table_or_dataset","output":"derived_result"},"constraints":["requires_data_extraction","requires_data_analysis"],"text":"Extract structured data and analyze it to produce a derived result."},
    {"id":"te_code_execute","intent":"code_and_execution","capabilities":["code_generation","executable_computation"],"slots":{"operation":"generate_and_execute","object":"computed_result","source":"task_specification","artifact":"code","output":"derived_result"},"constraints":["requires_code_generation","requires_actual_computation"],"text":"Generate code and execute it to derive the requested result."}
  ]
}
